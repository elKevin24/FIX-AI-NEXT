  "cards": [
    {
      "dot": "cyan",
      "title": "Flujo Principal & Multi-Tenancy",
      "items": [
        "Tráfico HTTPS ingresa por Edge Proxy con normalización y rate limit",
        "getTenantPrisma inyecta obligatoriamente where: { tenantId } y auditoría",
        "Neon Serverless Postgres gestiona el almacenamiento con connection pooling"
      ]
    },
    {
      "dot": "rose",
      "title": "Seguridad & Zero-Trust",
      "items": [
        "Rate limiting distribuido en Upstash Redis por IP para login, búsqueda y exportación",
        "NextAuth v5 gestiona credenciales con Bcrypt, JWT y bloqueo por intentos fallidos",
        "Validación Zod estricta en Server Actions previa a cualquier mutación de dominio"
      ]
    },
    {
      "dot": "emerald",
      "title": "Eventos Asíncronos",
      "items": [
        "Event Bus en memoria desacopla la creación/actualización de tickets y ventas POS",
        "Plantillas React Email renderizadas en tiempo de ejecución para notificaciones",
        "Despacho asíncrono vía Nodemailer hacia Gateway SMTP externo"
      ]
    }
  ]
