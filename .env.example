# ===========================================
# DATABASE CONFIGURATION (Prisma + PostgreSQL)
# ===========================================

# Connection URL for runtime (pooled connection - recommended for serverless)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Direct connection URL for migrations (non-pooled)
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ===========================================
# AUTHENTICATION (Stack Auth / NextAuth)
# ===========================================

# Stack Auth project credentials
NEXT_PUBLIC_STACK_PROJECT_ID=your-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=pck_your-publishable-key
STACK_SECRET_SERVER_KEY=ssk_your-secret-key

# ===========================================
# EMAIL SERVICE
# ===========================================

# Provider selection (optional; auto-detected if unset):
#   smtp   -> nodemailer via SMTP_HOST/SMTP_USER (free: Gmail, etc.)
#   resend -> Resend API
#   log    -> only log to console (dev)
EMAIL_PROVIDER=smtp

# --- SMTP (free option: Gmail app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-16-char-app-password

# --- Resend (alternative) ---
# RESEND_API_KEY=re_your-api-key

# Email sender address
EMAIL_FROM='FIX-AI <youraccount@gmail.com>'

# ===========================================
# AI SERVICES (Google Gemini)
# ===========================================

# Google AI API Key for Gemini SDK
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key
