# ===========================================
# DATABASE CONFIGURATION (Prisma + PostgreSQL / Neon)
# ===========================================

# Connection URL for runtime (pooled connection - recommended for serverless)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Direct connection URL for migrations (non-pooled)
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ===========================================
# AUTHENTICATION (NextAuth.js v5)
# ===========================================

# NextAuth Secret for JWT signature (generate with: npx auth secret)
AUTH_SECRET="your_super_secret_generated_string_here"

# NextAuth URL (optional in Vercel, required for custom domain / localhost)
AUTH_URL="http://localhost:3000"

# ===========================================
# RATE LIMITING & CACHE (Upstash Redis)
# ===========================================

# Upstash Redis REST credentials (for distributed rate limiting in serverless)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# ===========================================
# FILE STORAGE (Vercel Blob)
# ===========================================

# Vercel Blob Read/Write token for attachments
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# ===========================================
# CRON & BACKGROUND WORKERS
# ===========================================

# Secret token for CRON endpoints (generate a random 32+ char string)
CRON_SECRET="your_secure_random_cron_secret_token"

# ===========================================
# EMAIL SERVICE (Nodemailer / SMTP)
# ===========================================

# Provider selection:
#   smtp -> nodemailer via SMTP_HOST/SMTP_USER (Gmail, AWS SES, Resend SMTP)
#   log  -> only log to console (development)
EMAIL_PROVIDER=smtp

# SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-16-char-app-password

# Email sender address
EMAIL_FROM='FIX-AI <youraccount@gmail.com>'
