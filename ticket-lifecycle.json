{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Ticket Lifecycle State Machine",
    "output": "ticket-lifecycle.html",
    "viewBox": [1040, 660],
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-lifecycle",
        "label": "Flujo Principal de Reparación",
        "focus": ["open", "diagnosis", "waiting_approval", "in_repair", "closed"],
        "note": "Ruta secuencial óptima desde la recepción en taller hasta el cierre y facturación."
      },
      {
        "id": "parts-and-waiting",
        "label": "Espera de Piezas y Control",
        "focus": ["waiting_approval", "waiting_parts", "in_repair"],
        "note": "Interrupciones operativas por adquisición de repuestos y validación."
      },
      {
        "id": "terminal-exits",
        "label": "Salidas y Cancelaciones",
        "focus": ["waiting_parts", "cancelled", "in_repair", "rejected"],
        "note": "Salidas del ciclo de vida por cancelación o rechazo de cotización."
      }
    ]
  },
  "lanes": [
    { "id": "main", "label": "Fases Principales de Servicio" },
    { "id": "waiting", "label": "Interrupciones & Stock" },
    { "id": "terminal", "label": "Salidas Terminales" }
  ],
  "states": [
    {
      "id": "open",
      "type": "start",
      "label": "Ingresado",
