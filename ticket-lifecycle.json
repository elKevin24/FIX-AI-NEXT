      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "Recepción"
    },
    {
      "id": "diagnosis",
      "type": "active",
      "label": "Diagnóstico",
      "sublabel": "IN_PROGRESS",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "Técnico"
    },
    {
      "id": "waiting_approval",
      "type": "decision",
      "label": "Presupuesto",
      "sublabel": "WAITING_APPROVAL",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "Cliente"
    },
    {
      "id": "in_repair",
      "type": "active",
      "label": "Reparación",
      "sublabel": "RESOLVED",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "Taller"
    },
    {
      "id": "closed",
      "type": "success",
      "label": "Cerrado",
      "sublabel": "CLOSED",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "Facturado"
    },
    {
      "id": "waiting_parts",
      "type": "waiting",
