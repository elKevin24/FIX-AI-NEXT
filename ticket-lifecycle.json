      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "id": "trans-parts-to-repair",
      "from": "waiting_parts",
      "to": "in_repair",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "bottom",
      "via": [[470, 307], [556, 307]]
    },
    {
      "id": "trans-parts-cancelled",
      "from": "waiting_parts",
      "to": "cancelled",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "id": "trans-repair-rejected",
      "from": "in_repair",
      "to": "rejected",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Reglas de Transición y Cierre",
      "items": [
        "Progreso: OPEN → Diagnóstico → Presupuesto → Reparación → CLOSED (Venta POS)",
        "WAITING_FOR_PARTS retiene por stock; CANCELLED / REJECTED liberan reservas"
      ]
    }
  ]
