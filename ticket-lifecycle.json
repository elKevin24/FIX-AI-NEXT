    },
    {
      "id": "cancelled",
      "type": "failure",
      "label": "Cancelado",
      "sublabel": "CANCELLED",
      "lane": "terminal",
      "col": 0,
      "tag": "Salida"
    },
    {
      "id": "rejected",
      "type": "failure",
      "label": "Rechazado",
      "sublabel": "REJECTED",
      "lane": "terminal",
      "col": 1,
      "tag": "Salida"
    }
